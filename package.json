{
  "name": "proyecto2-saucedemo-serenity",
  "version": "1.0.0",
  "description": "Automatización de compra en SauceDemo con Serenity/JS (Serenity BDD), Cucumber, Playwright y patrón Screenplay. Datos desde Excel y evidencia en PDF.",
  "private": true,
  "scripts": {
    "clean": "rimraf target",
    "data:excel": "ts-node scripts/crear-excel.ts",
    "test": "failsafe clean test:execute test:report",
    "test:headed": "failsafe clean test:execute:headed test:report",
    "test:execute": "cross-env HEADLESS=true cucumber-js",
    "test:execute:headed": "cross-env HEADLESS=false SLOW_MO=300 cucumber-js",
    "test:report": "serenity-bdd run --features ./features",
    "postinstall": "serenity-bdd update",
    "lint:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@serenity-js/assertions": "^3.49.0",
    "@serenity-js/console-reporter": "^3.49.0",
    "@serenity-js/core": "^3.49.0",
    "@serenity-js/cucumber": "^3.49.0",
    "@serenity-js/playwright": "^3.49.0",
    "@serenity-js/serenity-bdd": "^3.49.0",
    "@serenity-js/web": "^3.49.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "cross-env": "^10.1.0",
    "exceljs": "^4.4.0",
    "npm-failsafe": "^1.4.0",
    "pdfkit": "^0.20.2",
    "playwright": "~1.64.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  }
}
